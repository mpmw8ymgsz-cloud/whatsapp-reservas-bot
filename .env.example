PORT=3000

# 'meta' (oficial, requiere app aprobada en Meta) o 'baileys' (no oficial, vía QR, sin verificacion de negocio)
WHATSAPP_PROVIDER=meta

# Token de acceso de Meta (System User token permanente, ver README)
META_TOKEN=tu_token_de_acceso_de_meta

# ID del número de WhatsApp (Phone Number ID), lo ves en Meta for Developers > WhatsApp > API Setup
PHONE_NUMBER_ID=tu_phone_number_id

# Token secreto que TU inventas, para verificar el webhook con Meta
VERIFY_TOKEN=un_token_secreto_que_tu_inventes

# Número de WhatsApp del dueño/administrador para recibir notificaciones de nuevas reservas
# Formato internacional sin '+' ni espacios, ej: 34600000000
# Si se deja vacío, el bot usa el WhatsApp Business de Nicolás Sánchez Monge (34661724158).
ADMIN_PHONE=

# Credenciales de tu base de datos en Turso (turso.tech), ver README
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso

# Clave del panel /admin?key=... y del envío manual de plantillas.
# No la compartas: da acceso a teléfonos de clientes y permite mandar la plantilla.
ADMIN_KEY=

# Plantilla de marketing (comida de Navidad para empresas). Hay que crearla en Meta
# y esperar a que esté APPROVED. El bot no la envía solo: hace falta un POST manual.
# Nombre interno y idioma (es = español).
MARKETING_TEMPLATE_NAME=comida_navidad_empresas_2026
MARKETING_TEMPLATE_LANG=es
# Cabecera IMAGE. Uno de los dos, opcional hasta que la plantilla aprobada la exija.
# Si defines los dos, se usa el media id.
MARKETING_TEMPLATE_HEADER_MEDIA_ID=
MARKETING_TEMPLATE_HEADER_IMAGE_URL=
